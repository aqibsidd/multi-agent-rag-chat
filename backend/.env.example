# Ollama base URL (default local install)
OLLAMA_BASE_URL=http://localhost:11434

# Chat model, pulled via `ollama pull llama3.2`
OLLAMA_CHAT_MODEL=llama3.2

# Embedding model, pulled via `ollama pull mxbai-embed-large`
# (1024-dim; changing it requires re-ingest — ensure_collection recreates
# the Qdrant collection when the size mismatches. Needs `ollama serve`.)
OLLAMA_EMBED_MODEL=mxbai-embed-large

# Qdrant URL (default local Docker install, see docker-compose.yml)
QDRANT_URL=http://localhost:6333

# FastAPI server port
PORT=8000

# SQLite file for LangGraph conversation checkpoints (free, local, persistent).
# Swap for Postgres/Redis later without touching agents.
CHECKPOINT_DB_PATH=checkpoints.db

# Auto-save facts the user states in chat ("my father is X") into Qdrant so
# they survive restarts and new sessions. Set false to disable (tests do).
MEMORY_AUTO_INGEST=true

# System deps for scanned-PDF/image OCR fallback (pypdf first, Tesseract when
# a page has <50 chars): `brew install tesseract poppler`
