# Ollama base URL (default local install)
OLLAMA_BASE_URL=http://localhost:11434

# Chat model ladder: NVIDIA Nemotron (primary) -> OpenRouter (one-line
# model switch, 300+ models) -> Google Gemini Flash -> Groq Llama
# (fallbacks). All API — no local LLM needed to deploy. Providers without
# a key are skipped. Free tiers: Google AI Studio + GroqCloud console.
# OpenRouter: https://openrouter.ai/keys (model slugs like
# `anthropic/claude-3.5-sonnet`, `openai/gpt-4o-mini`, etc.)
# NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
GOOGLE_CHAT_MODEL=gemini-2.5-flash
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama is now embeddings-only locally (mxbai-embed-large, 1024-dim).
# (Changing it requires re-ingest — ensure_collection recreates
# the Qdrant collection when the size mismatches. Needs `ollama serve`.)
OLLAMA_EMBED_MODEL=mxbai-embed-large

# Cloud embeddings (Render): EMBED_PROVIDER=google uses gemini-embedding-001
# (3072-dim, same GOOGLE_API_KEY as chat fallback — no extra key).
# EMBED_PROVIDER=ollama
# GOOGLE_EMBED_MODEL=models/gemini-embedding-001

# Qdrant: local Docker by default (see docker-compose.yml).
# Cloud (Render): paste Qdrant Cloud cluster URL + API key (empty = local).
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# FastAPI server port
PORT=8000

# SQLite file for LangGraph conversation checkpoints (free, local, persistent).
# Multi-instance deploys: set CHECKPOINTER_URL to Postgres instead
# (see docker-compose.yml `postgres` profile) — same thread contract.
CHECKPOINT_DB_PATH=checkpoints.db
CHECKPOINTER_URL=

# Retrieval relevance gate (cosine): chunks scoring below this are dropped
# before prompting, so junk retrieval falls back honestly instead of
# polluting the answer.
RELEVANCE_MIN_SCORE=0.5

# Per-tenant isolation: pass `user_id` (body/header) to scope Qdrant
# collections + threads. Empty = legacy single-user behavior.
# Upload guard: files/text larger than this are rejected with 413.
MAX_UPLOAD_MB=10

# Auto-save facts the user states in chat ("my father is X") into Qdrant so
# they survive restarts and new sessions. Set false to disable (tests do).
MEMORY_AUTO_INGEST=true

# System deps for scanned-PDF/image OCR fallback (pypdf first, Tesseract when
# a page has <50 chars): `brew install tesseract poppler`
